<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Control Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <!-- Status Indicator -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_status_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/warning_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Device Selector -->
            <Spinner
                android:id="@+id/spinnerDevices"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:minWidth="160dp"
                android:background="@color/surface_card"
                android:paddingHorizontal="8dp" />

            <!-- Connect / Disconnect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:text="@string/connect"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <!-- Pair New PC Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPair"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="10dp"
                android:text="+ Pair PC"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="10dp"
                android:background="#334155" />

            <!-- Aspect Ratio Selector -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleAspectRatio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:checkedButton="@id/btnRatio16_9"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatio16_9"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="16:9"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatio16_10"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="16:10"
                    android:textSize="10sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Turbo Mode Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTurbo"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Turbo ⚡ [OFF]"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Blackout Mode Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlackout"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Blackout 🌙"
                android:textSize="10sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Canvas Surface -->
    <com.tablet.penemulator.TabletCanvasView
        android:id="@+id/canvasView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTopBar" />

    <!-- Restore UI Button (Shown in Blackout mode to wake up) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWakeUI"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        android:text="🌙 Blackout Active • Tap bar with finger to exit"
        android:textColor="@color/primary_accent"
        android:textSize="12sp"
        android:visibility="gone"
        app:backgroundTint="#D0181B22"
        app:cornerRadius="22dp"
        app:strokeColor="@color/primary_accent"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
